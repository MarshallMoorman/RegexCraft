<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RegexCraft.App.ViewModels"
        xmlns:ae="using:AvaloniaEdit"
        xmlns:analysis="using:RegexCraft.Core.Analysis"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="RegexCraft.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="{Binding WindowTitle}"
        Width="1320" Height="860"
        MinWidth="1000" MinHeight="680"
        Background="{DynamicResource BackgroundPrimaryBrush}">

  <Design.DataContext>
    <vm:MainWindowViewModel />
  </Design.DataContext>

  <Window.Styles>
    <!-- Mode / tab buttons -->
    <Style Selector="Button.modeTab">
      <Setter Property="Padding" Value="14,7" />
      <Setter Property="Margin" Value="0,0,4,0" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextOnPrimaryBrush}" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.modeTab:pointerover">
      <Setter Property="Background" Value="{DynamicResource PrimaryBlueHoverBrush}" />
    </Style>
    <Style Selector="Button.modeTab.active">
      <Setter Property="Background" Value="{DynamicResource AccentBlueSoftBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryBlueBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="Button.panelTab">
      <Setter Property="Padding" Value="14,9" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0,0,0,2" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="Button.panelTab:pointerover">
      <Setter Property="Background" Value="{DynamicResource AccentBlueSoftBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryBlueBrush}" />
    </Style>
    <Style Selector="Button.panelTab.active">
      <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBlueBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryBlueBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Background" Value="{DynamicResource BackgroundSecondaryBrush}" />
    </Style>

    <Style Selector="Button.ghost">
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryBlueBrush}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.ghost:pointerover">
      <Setter Property="Background" Value="{DynamicResource AccentBlueSoftBrush}" />
    </Style>

    <Style Selector="Button.primaryAction">
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="Background" Value="{DynamicResource PrimaryBlueBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextOnPrimaryBrush}" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.primaryAction:pointerover">
      <Setter Property="Background" Value="{DynamicResource PrimaryBlueHoverBrush}" />
    </Style>

    <!-- Analysis tree starts expanded for usefulness -->
    <Style Selector="TreeViewItem">
      <Setter Property="IsExpanded" Value="True" />
    </Style>
  </Window.Styles>

  <DockPanel>

    <!-- Toolbar -->
    <Border DockPanel.Dock="Top"
            Background="{DynamicResource PrimaryBlueBrush}"
            Padding="14,10">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <TextBlock Text="RegexCraft"
                     FontSize="18"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource TextOnPrimaryBrush}"
                     VerticalAlignment="Center" />
          <Border Background="{DynamicResource AccentBlueSoftBrush}"
                  CornerRadius="4"
                  Padding="8,2"
                  VerticalAlignment="Center">
            <TextBlock Text="{Binding VersionText}"
                       FontSize="11"
                       FontWeight="Medium"
                       Foreground="{DynamicResource PrimaryBlueBrush}" />
          </Border>
        </StackPanel>

        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="6"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
          <TextBlock Text="Flavor"
                     Foreground="{DynamicResource TextOnPrimaryBrush}"
                     Opacity="0.9"
                     VerticalAlignment="Center"
                     FontSize="12"
                     Margin="0,0,2,0" />
          <ComboBox ItemsSource="{Binding Flavors}"
                    SelectedItem="{Binding SelectedFlavor}"
                    MinWidth="110"
                    ToolTip.Tip="Select regex flavor / engine (.NET or PCRE2)">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding DisplayName}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <Border Width="1" Height="20" Background="{DynamicResource TextOnPrimaryBrush}" Opacity="0.3" Margin="6,0" />

          <Button Content="Match"
                  Classes="modeTab"
                  Classes.active="{Binding IsMatchMode}"
                  Command="{Binding SelectRightTabCommand}"
                  CommandParameter="Test"
                  ToolTip.Tip="Match mode (Ctrl+1). Live updates while typing. Ctrl+Enter to run." />
          <Button Content="Replace"
                  Classes="modeTab"
                  Classes.active="{Binding IsReplaceMode}"
                  Command="{Binding SelectRightTabCommand}"
                  CommandParameter="Replace"
                  ToolTip.Tip="Replace mode (Ctrl+2) with live preview" />
          <Button Content="Split"
                  Classes="modeTab"
                  Classes.active="{Binding IsSplitMode}"
                  Command="{Binding SelectRightTabCommand}"
                  CommandParameter="Split"
                  ToolTip.Tip="Split mode (Ctrl+3)" />
          <Button Content="Generate"
                  Classes="modeTab"
                  Classes.active="{Binding IsGenerateMode}"
                  Command="{Binding SelectRightTabCommand}"
                  CommandParameter="Generate"
                  ToolTip.Tip="Code generation (Ctrl+4)" />
          <Button Content="GREP"
                  Classes="modeTab"
                  Classes.active="{Binding IsGrepMode}"
                  Command="{Binding SelectRightTabCommand}"
                  CommandParameter="Grep"
                  ToolTip.Tip="Search &amp; replace across files/folders (Ctrl+5)" />

          <Border Width="1" Height="20" Background="{DynamicResource TextOnPrimaryBrush}" Opacity="0.3" Margin="6,0" />

          <Button Content="Options"
                  Classes="modeTab"
                  Command="{Binding ToggleOptionsCommand}"
                  ToolTip.Tip="Show or hide regex options" />
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Text="Theme"
                     Foreground="{DynamicResource TextOnPrimaryBrush}"
                     Opacity="0.85"
                     VerticalAlignment="Center"
                     FontSize="12" />
          <Button Content="{Binding ThemeLabel}"
                  Command="{Binding CycleThemeCommand}"
                  MinWidth="72"
                  Padding="10,4"
                  ToolTip.Tip="Cycle theme: System → Light → Dark" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Options strip -->
    <Border DockPanel.Dock="Top"
            IsVisible="{Binding OptionsExpanded}"
            Background="{DynamicResource BackgroundSecondaryBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}"
            BorderThickness="0,0,0,1"
            Padding="14,8">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
          <TextBlock Text="Options"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     VerticalAlignment="Center"
                     FontSize="12" />
          <CheckBox Content="Ignore case" IsChecked="{Binding IgnoreCase}" FontSize="12"
                    ToolTip.Tip="Case-insensitive matching (both engines)" />
          <CheckBox Content="Multiline" IsChecked="{Binding Multiline}" FontSize="12"
                    ToolTip.Tip="^ and $ match line start/end (both engines)" />
          <CheckBox Content="Singleline" IsChecked="{Binding Singleline}" FontSize="12"
                    ToolTip.Tip="Dot (.) matches newline — .NET Singleline / PCRE DOTALL" />
          <CheckBox Content="Explicit capture" IsChecked="{Binding ExplicitCapture}"
                    IsEnabled="{Binding ExplicitCaptureEnabled}" FontSize="12"
                    ToolTip.Tip=".NET: only named groups capture. PCRE2: approximated via engine options." />
          <CheckBox Content="Ignore pattern whitespace" IsChecked="{Binding IgnorePatternWhitespace}" FontSize="12"
                    ToolTip.Tip="Ignore unescaped whitespace and enable # comments (.NET / PCRE extended)" />
        </StackPanel>
        <TextBlock Grid.Column="2"
                   Text="{Binding OptionsContextLabel}"
                   FontSize="11"
                   Foreground="{DynamicResource TextMutedBrush}"
                   VerticalAlignment="Center"
                   Margin="16,0,0,0" />
      </Grid>
    </Border>

    <!-- Status bar -->
    <Border DockPanel.Dock="Bottom"
            Background="{DynamicResource BackgroundTertiaryBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}"
            BorderThickness="0,1,0,0"
            Padding="14,7">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">
        <TextBlock Text="{Binding StatusText}"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   FontSize="12"
                   TextTrimming="CharacterEllipsis"
                   VerticalAlignment="Center" />
        <TextBlock Grid.Column="1"
                   Text="{Binding StatusEngine}"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   FontSize="12"
                   Margin="16,0,0,0"
                   VerticalAlignment="Center" />
        <TextBlock Grid.Column="2"
                   Text="{Binding StatusMatches}"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   FontWeight="SemiBold"
                   FontSize="12"
                   Margin="16,0,0,0"
                   VerticalAlignment="Center" />
        <TextBlock Grid.Column="3"
                   Text="{Binding StatusTime}"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   FontSize="12"
                   Margin="16,0,0,0"
                   VerticalAlignment="Center" />
        <TextBlock Grid.Column="4"
                   Text="{Binding ShortcutHints}"
                   Foreground="{DynamicResource TextMutedBrush}"
                   FontSize="11"
                   Margin="12,0,0,0"
                   VerticalAlignment="Center" />
      </Grid>
    </Border>

    <!-- Body -->
    <Grid ColumnDefinitions="280,*,400" Margin="0">

      <!-- LEFT: Tokens / Library / History -->
      <Border Grid.Column="0"
              Background="{DynamicResource BackgroundSecondaryBrush}"
              BorderBrush="{DynamicResource BorderSubtleBrush}"
              BorderThickness="0,0,1,0">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top"
                      Orientation="Horizontal"
                      Background="{DynamicResource BackgroundTertiaryBrush}"
                      Margin="0,0,0,0">
            <Button Content="Tokens"
                    Classes="panelTab"
                    Classes.active="{Binding IsTokensTab}"
                    Command="{Binding SelectLeftTabCommand}"
                    CommandParameter="Tokens" />
            <Button Content="Library"
                    Classes="panelTab"
                    Classes.active="{Binding IsLibraryTab}"
                    Command="{Binding SelectLeftTabCommand}"
                    CommandParameter="Library" />
            <Button Content="History"
                    Classes="panelTab"
                    Classes.active="{Binding IsHistoryTab}"
                    Command="{Binding SelectLeftTabCommand}"
                    CommandParameter="History" />
          </StackPanel>

          <!-- TOKENS -->
          <DockPanel IsVisible="{Binding IsTokensTab}">
            <TextBox DockPanel.Dock="Top"
                     Text="{Binding TokenSearch}"
                     PlaceholderText="Search tokens…"
                     Margin="12,10,12,8"
                     ToolTip.Tip="Filter by label, insert text, or category" />
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding TokenCategories}" Margin="6,0,6,10">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:TokenCategoryViewModel">
                    <Expander IsExpanded="True" Margin="2,2">
                      <Expander.Header>
                        <TextBlock Text="{Binding Name}"
                                   FontWeight="SemiBold"
                                   FontSize="12"
                                   Foreground="{DynamicResource PrimaryBlueBrush}" />
                      </Expander.Header>
                      <ItemsControl ItemsSource="{Binding Tokens}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:TokenItemViewModel">
                            <Button HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="8,5"
                                    Margin="0,1"
                                    CornerRadius="4"
                                    Opacity="{Binding Opacity}"
                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).InsertTokenCommand}"
                                    CommandParameter="{Binding}"
                                    ToolTip.Tip="{Binding Tooltip}">
                              <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{Binding Label}"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontSize="12"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding InsertText}"
                                           FontFamily="Menlo, Consolas, monospace"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="8,0,0,0" />
                              </Grid>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Expander>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>

          <!-- LIBRARY -->
          <DockPanel IsVisible="{Binding IsLibraryTab}" Margin="0">
            <Border DockPanel.Dock="Top" Padding="12,10" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
              <StackPanel Spacing="6">
                <TextBlock Text="Save current pattern"
                           FontWeight="SemiBold"
                           FontSize="12"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBox Text="{Binding LibraryName}"
                         PlaceholderText="Name"
                         FontSize="12" />
                <TextBox Text="{Binding LibraryDescription}"
                         PlaceholderText="Description (optional)"
                         FontSize="12" />
                <TextBox Text="{Binding LibraryCategory}"
                         PlaceholderText="Category (optional)"
                         FontSize="12" />
                <TextBox Text="{Binding LibraryTags}"
                         PlaceholderText="Tags (comma-separated)"
                         FontSize="12" />
                <CheckBox Content="Favorite"
                          IsChecked="{Binding LibraryFavorite}"
                          FontSize="12" />
                <Button Content="Save to Library"
                        Classes="primaryAction"
                        Command="{Binding SaveToLibraryCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center" />
              </StackPanel>
            </Border>
            <TextBox DockPanel.Dock="Top"
                     Text="{Binding LibrarySearch}"
                     PlaceholderText="Search library…"
                     Margin="12,8,12,6"
                     FontSize="12" />
            <TextBlock DockPanel.Dock="Top"
                       IsVisible="{Binding !LibraryItems.Count}"
                       Text="No saved patterns yet. Save your first pattern above."
                       TextWrapping="Wrap"
                       Margin="14,8"
                       FontSize="12"
                       Foreground="{DynamicResource TextMutedBrush}" />
            <ListBox ItemsSource="{Binding LibraryItems}"
                     Margin="8,0,8,8"
                     Background="Transparent"
                     BorderThickness="0">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:LibraryItemViewModel">
                  <Border Padding="8,8" Margin="0,2" CornerRadius="4"
                          Background="{DynamicResource BackgroundTertiaryBrush}">
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                      <TextBlock Text="{Binding Name}"
                                 FontWeight="SemiBold"
                                 FontSize="12"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Row="1"
                                 Text="{Binding Subtitle}"
                                 FontSize="11"
                                 FontFamily="Menlo, Consolas, monospace"
                                 Foreground="{DynamicResource TextSecondaryBrush}"
                                 TextTrimming="CharacterEllipsis"
                                 Margin="0,2,0,0" />
                      <StackPanel Grid.Column="1" Grid.RowSpan="2"
                                  Orientation="Horizontal" Spacing="2"
                                  VerticalAlignment="Center">
                        <Button Content="{Binding FavoriteLabel}"
                                Classes="ghost"
                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ToggleLibraryFavoriteCommand}"
                                CommandParameter="{Binding}"
                                ToolTip.Tip="Toggle favorite" />
                        <Button Content="Load"
                                Classes="ghost"
                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).LoadLibraryItemCommand}"
                                CommandParameter="{Binding}" />
                        <Button Content="✕"
                                Classes="ghost"
                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).DeleteLibraryItemCommand}"
                                CommandParameter="{Binding}"
                                ToolTip.Tip="Delete" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>

          <!-- HISTORY -->
          <DockPanel IsVisible="{Binding IsHistoryTab}">
            <Border DockPanel.Dock="Top" Padding="12,8">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Recent patterns"
                           FontWeight="SemiBold"
                           FontSize="12"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Content="Clear"
                        Classes="ghost"
                        Command="{Binding ClearHistoryCommand}" />
              </Grid>
            </Border>
            <TextBlock DockPanel.Dock="Top"
                       IsVisible="{Binding !HistoryItems.Count}"
                       Text="History is empty. Patterns appear here after you test them."
                       TextWrapping="Wrap"
                       Margin="14,4"
                       FontSize="12"
                       Foreground="{DynamicResource TextMutedBrush}" />
            <ListBox ItemsSource="{Binding HistoryItems}"
                     Margin="8,0,8,8"
                     Background="Transparent"
                     BorderThickness="0">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:HistoryItemViewModel">
                  <Button HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Left"
                          Background="{DynamicResource BackgroundTertiaryBrush}"
                          BorderThickness="0"
                          Padding="10,8"
                          Margin="0,2"
                          CornerRadius="4"
                          Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).LoadHistoryItemCommand}"
                          CommandParameter="{Binding}"
                          ToolTip.Tip="Click to restore">
                    <StackPanel Spacing="2">
                      <TextBlock Text="{Binding Label}"
                                 FontFamily="Menlo, Consolas, monospace"
                                 FontSize="12"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding When}"
                                 FontSize="10"
                                 Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </DockPanel>
      </Border>

      <!-- CENTER: Editor + Analysis -->
      <Grid Grid.Column="1" RowDefinitions="*,4,220">
        <Border Grid.Row="0" Background="{DynamicResource BackgroundSecondaryBrush}">
          <DockPanel>
            <Border DockPanel.Dock="Top"
                    Padding="12,8"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="0,0,0,1"
                    Background="{DynamicResource BackgroundTertiaryBrush}">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Regex Editor"
                           FontWeight="SemiBold"
                           FontSize="12"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Content="Copy pattern"
                        Classes="ghost"
                        Command="{Binding CopyPatternCommand}"
                        ToolTip.Tip="Copy the full pattern to the clipboard" />
              </Grid>
            </Border>
            <ae:TextEditor x:Name="PatternEditor"
                           FontFamily="Menlo, Consolas, monospace"
                           FontSize="14"
                           ShowLineNumbers="True"
                           HorizontalScrollBarVisibility="Auto"
                           VerticalScrollBarVisibility="Auto" />
          </DockPanel>
        </Border>

        <GridSplitter Grid.Row="1"
                      Background="{DynamicResource BorderSubtleBrush}"
                      ResizeDirection="Rows" />

        <Border Grid.Row="2"
                Background="{DynamicResource BackgroundSecondaryBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,1,0,0">
          <DockPanel>
            <Border DockPanel.Dock="Top"
                    Padding="12,7"
                    Background="{DynamicResource BackgroundTertiaryBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="0,0,0,1">
              <TextBlock Text="Analysis Tree — click a node to select it in the editor"
                         FontWeight="SemiBold"
                         FontSize="12"
                         Foreground="{DynamicResource TextPrimaryBrush}" />
            </Border>
            <TreeView x:Name="AnalysisTree"
                      ItemsSource="{Binding AnalysisNodes}"
                      SelectedItem="{Binding SelectedAnalysisNode}"
                      Margin="6"
                      Background="Transparent">
              <TreeView.ItemTemplate>
                <TreeDataTemplate ItemsSource="{Binding Children}" DataType="analysis:AnalysisNode">
                  <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2">
                    <TextBlock Text="{Binding Title}"
                               FontWeight="SemiBold"
                               FontSize="12"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding Detail}"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="280" />
                    <TextBlock Text="{Binding PatternFragment}"
                               FontFamily="Menlo, Consolas, monospace"
                               FontSize="11"
                               Foreground="{DynamicResource PrimaryBlueBrush}"
                               Opacity="0.95"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="220" />
                  </StackPanel>
                </TreeDataTemplate>
              </TreeView.ItemTemplate>
            </TreeView>
          </DockPanel>
        </Border>
      </Grid>

      <!-- RIGHT: Test / Replace / Split / Generate -->
      <Border Grid.Column="2"
              Background="{DynamicResource BackgroundSecondaryBrush}"
              BorderBrush="{DynamicResource BorderSubtleBrush}"
              BorderThickness="1,0,0,0">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top"
                      Orientation="Horizontal"
                      Background="{DynamicResource BackgroundTertiaryBrush}">
            <Button Content="Test"
                    Classes="panelTab"
                    Classes.active="{Binding IsTestTab}"
                    Command="{Binding SelectRightTabCommand}"
                    CommandParameter="Test"
                    ToolTip.Tip="Match testing with highlighting" />
            <Button Content="Replace"
                    Classes="panelTab"
                    Classes.active="{Binding IsReplaceTab}"
                    Command="{Binding SelectRightTabCommand}"
                    CommandParameter="Replace"
                    ToolTip.Tip="Replace preview with highlighting" />
            <Button Content="Split"
                    Classes="panelTab"
                    Classes.active="{Binding IsSplitTab}"
                    Command="{Binding SelectRightTabCommand}"
                    CommandParameter="Split"
                    ToolTip.Tip="Split subject on matches" />
            <Button Content="Generate"
                    Classes="panelTab"
                    Classes.active="{Binding IsGenerateTab}"
                    Command="{Binding SelectRightTabCommand}"
                    CommandParameter="Generate"
                    ToolTip.Tip="Generate code snippets" />
            <Button Content="GREP"
                    Classes="panelTab"
                    Classes.active="{Binding IsGrepTab}"
                    Command="{Binding SelectRightTabCommand}"
                    CommandParameter="Grep"
                    ToolTip.Tip="Search &amp; replace across files" />
          </StackPanel>

          <Border DockPanel.Dock="Top"
                  IsVisible="{Binding HasError}"
                  BorderBrush="{DynamicResource ErrorBrush}"
                  BorderThickness="0,0,0,2"
                  Background="{DynamicResource BackgroundTertiaryBrush}"
                  Padding="10,8">
            <TextBlock Text="{Binding ErrorText}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource ErrorBrush}"
                       FontSize="12" />
          </Border>

          <!-- TEST -->
          <Grid IsVisible="{Binding IsTestTab}" RowDefinitions="Auto,*,Auto,*" Margin="0">
            <Border Grid.Row="0" Padding="12,10,12,4">
              <TextBlock Text="Subject"
                         FontWeight="SemiBold"
                         FontSize="12"
                         Foreground="{DynamicResource TextPrimaryBrush}" />
            </Border>
            <Border Grid.Row="1"
                    Margin="10,0,10,8"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    ClipToBounds="True">
              <ae:TextEditor x:Name="SubjectEditor"
                             FontFamily="Menlo, Consolas, monospace"
                             FontSize="13"
                             WordWrap="True"
                             HorizontalScrollBarVisibility="Disabled"
                             VerticalScrollBarVisibility="Auto" />
            </Border>

            <Border Grid.Row="2" Padding="12,4,12,4">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Matches &amp; Groups"
                           FontWeight="SemiBold"
                           FontSize="12"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Content="Run"
                        Classes="primaryAction"
                        Command="{Binding RunTestCommand}"
                        ToolTip.Tip="Run match immediately (Ctrl+Enter)" />
              </Grid>
            </Border>

            <Panel Grid.Row="3" Margin="10,0,10,10">
              <TextBlock Text="{Binding EmptyMatchesMessage}"
                         IsVisible="{Binding !Matches.Count}"
                         TextWrapping="Wrap"
                         FontSize="12"
                         Foreground="{DynamicResource TextMutedBrush}"
                         Margin="8,12"
                         HorizontalAlignment="Center" />
              <ListBox ItemsSource="{Binding Matches}"
                       Background="{DynamicResource BackgroundTertiaryBrush}"
                       BorderBrush="{DynamicResource BorderSubtleBrush}"
                       BorderThickness="1"
                       CornerRadius="4">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:MatchItemViewModel">
                    <Expander IsExpanded="{Binding IsExpanded}" Margin="2">
                      <Expander.Header>
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Text="{Binding Summary}"
                                     FontFamily="Menlo, Consolas, monospace"
                                     FontSize="12"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     TextTrimming="CharacterEllipsis"
                                     VerticalAlignment="Center" />
                          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                            <Button Content="Copy"
                                    Classes="ghost"
                                    Command="{Binding CopyMatchCommand}"
                                    ToolTip.Tip="Copy match value" />
                            <Button Content="Go"
                                    Classes="ghost"
                                    Command="{Binding SelectMatchCommand}"
                                    ToolTip.Tip="Select match in subject" />
                          </StackPanel>
                        </Grid>
                      </Expander.Header>
                      <ItemsControl ItemsSource="{Binding Groups}" Margin="8,4,4,4">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:GroupItemViewModel">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,3">
                              <Border Background="{DynamicResource AccentBlueSoftBrush}"
                                      CornerRadius="3"
                                      Padding="6,2"
                                      Margin="0,0,8,0">
                                <TextBlock Text="{Binding DisplayName}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryBlueBrush}" />
                              </Border>
                              <TextBlock Grid.Column="1"
                                         Text="{Binding DisplayValue}"
                                         FontFamily="Menlo, Consolas, monospace"
                                         FontSize="12"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         TextTrimming="CharacterEllipsis"
                                         VerticalAlignment="Center" />
                              <TextBlock Grid.Column="2"
                                         Text="{Binding RangeText}"
                                         FontSize="11"
                                         Foreground="{DynamicResource TextMutedBrush}"
                                         Margin="8,0"
                                         VerticalAlignment="Center" />
                              <StackPanel Grid.Column="3" Orientation="Horizontal">
                                <Button Content="Copy"
                                        Classes="ghost"
                                        Command="{Binding CopyGroupCommand}" />
                                <Button Content="Go"
                                        Classes="ghost"
                                        Command="{Binding SelectGroupCommand}" />
                              </StackPanel>
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Expander>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Panel>
          </Grid>

          <!-- REPLACE -->
          <Grid IsVisible="{Binding IsReplaceTab}" RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="10">
            <TextBlock Grid.Row="0"
                       Text="Replacement pattern"
                       FontWeight="SemiBold"
                       FontSize="12"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       Margin="0,4,0,4" />
            <TextBox Grid.Row="1"
                     Text="{Binding Replacement}"
                     FontFamily="Menlo, Consolas, monospace"
                     PlaceholderText="$1  ${name}  $&amp;  \1 …"
                     Margin="0,0,0,8"
                     ToolTip.Tip="Supports $1, ${name}, $&amp;, and engine-specific backreferences" />
            <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
              <TextBlock Text="Preview"
                         FontWeight="SemiBold"
                         FontSize="12"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         VerticalAlignment="Center" />
              <Button Grid.Column="1"
                      Content="Preview Replace"
                      Classes="primaryAction"
                      Command="{Binding RunReplaceCommand}"
                      ToolTip.Tip="Run replace (Ctrl+Enter)" />
            </Grid>
            <Border Grid.Row="3"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    ClipToBounds="True"
                    MinHeight="180">
              <ae:TextEditor x:Name="ReplacePreviewEditor"
                             FontFamily="Menlo, Consolas, monospace"
                             FontSize="13"
                             WordWrap="True"
                             IsReadOnly="True"
                             HorizontalScrollBarVisibility="Disabled"
                             VerticalScrollBarVisibility="Auto" />
            </Border>
            <TextBlock Grid.Row="4"
                       Margin="0,10,0,0"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondaryBrush}">
              <TextBlock.Text>
                <MultiBinding StringFormat="Replacements: {0}">
                  <Binding Path="ReplaceCount" />
                </MultiBinding>
              </TextBlock.Text>
            </TextBlock>
          </Grid>

          <!-- SPLIT -->
          <Grid IsVisible="{Binding IsSplitTab}" RowDefinitions="Auto,Auto,*" Margin="10">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,4,0,8">
              <CheckBox Content="Remove empty entries"
                        IsChecked="{Binding RemoveEmptySplitEntries}"
                        FontSize="12"
                        VerticalAlignment="Center" />
              <Button Grid.Column="1"
                      Content="Run Split"
                      Classes="primaryAction"
                      Command="{Binding RunSplitCommand}"
                      ToolTip.Tip="Split subject on pattern matches (Ctrl+Enter)" />
            </Grid>
            <TextBlock Grid.Row="1"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,0,0,8">
              <TextBlock.Text>
                <MultiBinding StringFormat="Parts: {0}">
                  <Binding Path="SplitPartCount" />
                </MultiBinding>
              </TextBlock.Text>
            </TextBlock>
            <ListBox Grid.Row="2"
                     ItemsSource="{Binding SplitParts}"
                     Background="{DynamicResource BackgroundTertiaryBrush}"
                     BorderBrush="{DynamicResource BorderSubtleBrush}"
                     BorderThickness="1"
                     CornerRadius="4">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:SplitPartViewModel">
                  <Border Padding="10,8" Margin="2">
                    <StackPanel Spacing="2">
                      <TextBlock Text="{Binding Summary}"
                                 FontFamily="Menlo, Consolas, monospace"
                                 FontSize="12"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>

          <!-- GENERATE -->
          <Grid IsVisible="{Binding IsGenerateTab}" RowDefinitions="Auto,Auto,Auto,*" Margin="10">
            <TextBlock Grid.Row="0"
                       Text="Code Generation"
                       FontWeight="SemiBold"
                       FontSize="13"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       Margin="0,4,0,10" />
            <Grid Grid.Row="1" ColumnDefinitions="*,*" Margin="0,0,0,8">
              <StackPanel Margin="0,0,6,0" Spacing="4">
                <TextBlock Text="Language" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                <ComboBox ItemsSource="{Binding CodeLanguages}"
                          SelectedItem="{Binding SelectedCodeLanguage}"
                          HorizontalAlignment="Stretch">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding DisplayName}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>
              <StackPanel Grid.Column="1" Margin="6,0,0,0" Spacing="4">
                <TextBlock Text="Operation" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                <ComboBox ItemsSource="{Binding CodegenOperations}"
                          SelectedItem="{Binding SelectedCodegenOperation}"
                          HorizontalAlignment="Stretch">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding DisplayName}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>
            </Grid>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,0,0,8">
              <Button Content="Copy code"
                      Classes="primaryAction"
                      Command="{Binding CopyGeneratedCodeCommand}"
                      ToolTip.Tip="Copy generated snippet to clipboard" />
            </StackPanel>
            <Border Grid.Row="3"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    ClipToBounds="True">
              <ae:TextEditor x:Name="GenerateCodeEditor"
                             FontFamily="Menlo, Consolas, monospace"
                             FontSize="12"
                             IsReadOnly="True"
                             WordWrap="False"
                             ShowLineNumbers="True"
                             HorizontalScrollBarVisibility="Auto"
                             VerticalScrollBarVisibility="Auto" />
            </Border>
          </Grid>

          <!-- GREP -->
          <Grid IsVisible="{Binding IsGrepTab}" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto,*" Margin="10">
            <TextBlock Grid.Row="0"
                       Text="GREP — search &amp; replace across files"
                       FontWeight="SemiBold"
                       FontSize="13"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       Margin="0,2,0,8" />

            <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
              <TextBox Text="{Binding GrepRootPath}"
                       PlaceholderText="Folder path…"
                       FontSize="12"
                       FontFamily="Menlo, Consolas, monospace" />
              <Button Grid.Column="1"
                      Content="Browse…"
                      Classes="primaryAction"
                      Margin="8,0,0,0"
                      Command="{Binding BrowseGrepFolderCommand}"
                      ToolTip.Tip="Pick a folder to search" />
            </Grid>

            <StackPanel Grid.Row="2" Spacing="6" Margin="0,0,0,6">
              <Grid ColumnDefinitions="Auto,*">
                <TextBlock Text="Include"
                           FontSize="11"
                           Width="56"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBox Grid.Column="1"
                         Text="{Binding GrepIncludeGlobs}"
                         FontSize="11"
                         FontFamily="Menlo, Consolas, monospace"
                         ToolTip.Tip="Include globs, semicolon-separated (e.g. *.cs;*.json)" />
              </Grid>
              <Grid ColumnDefinitions="Auto,*">
                <TextBlock Text="Exclude"
                           FontSize="11"
                           Width="56"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBox Grid.Column="1"
                         Text="{Binding GrepExcludeGlobs}"
                         FontSize="11"
                         FontFamily="Menlo, Consolas, monospace"
                         ToolTip.Tip="Exclude globs (e.g. bin/**;obj/**;.git/**)" />
              </Grid>
              <StackPanel Orientation="Horizontal" Spacing="14">
                <CheckBox Content="Recursive"
                          IsChecked="{Binding GrepRecursive}"
                          FontSize="12" />
                <CheckBox Content="Dry-run replace"
                          IsChecked="{Binding GrepDryRun}"
                          FontSize="12"
                          ToolTip.Tip="Preview replacements without writing files" />
                <CheckBox Content="Backup (.bak)"
                          IsChecked="{Binding GrepCreateBackup}"
                          FontSize="12"
                          ToolTip.Tip="Write .bak beside each modified file when applying" />
              </StackPanel>
            </StackPanel>

            <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,0,0,8">
              <StackPanel Orientation="Vertical" Spacing="2">
                <TextBlock Text="{Binding GrepSummary}"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding GrepProgressText}"
                           FontSize="10"
                           Foreground="{DynamicResource TextMutedBrush}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding GrepReplaceSummary}"
                           FontSize="11"
                           Foreground="{DynamicResource PrimaryBlueBrush}"
                           TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <Button Grid.Column="1"
                      Content="Search"
                      Classes="primaryAction"
                      Command="{Binding RunGrepSearchCommand}"
                      IsEnabled="{Binding !IsGrepRunning}"
                      Margin="6,0,0,0"
                      ToolTip.Tip="Search files with the current pattern (Ctrl+Enter)" />
              <Button Grid.Column="2"
                      Content="Replace"
                      Classes="primaryAction"
                      Command="{Binding RunGrepReplaceCommand}"
                      IsEnabled="{Binding !IsGrepRunning}"
                      Margin="6,0,0,0"
                      ToolTip.Tip="Replace across files (respects Dry-run)" />
              <Button Grid.Column="3"
                      Content="Cancel"
                      Classes="ghost"
                      Command="{Binding CancelGrepCommand}"
                      IsEnabled="{Binding IsGrepRunning}"
                      Margin="6,0,0,0" />
            </Grid>

            <Panel Grid.Row="4" Margin="0,0,0,8">
              <TextBlock Text="{Binding GrepEmptyMessage}"
                         IsVisible="{Binding !GrepHits.Count}"
                         TextWrapping="Wrap"
                         FontSize="12"
                         Foreground="{DynamicResource TextMutedBrush}"
                         Margin="8,12"
                         HorizontalAlignment="Center" />
              <ListBox ItemsSource="{Binding GrepHits}"
                       SelectedItem="{Binding SelectedGrepHit}"
                       Background="{DynamicResource BackgroundTertiaryBrush}"
                       BorderBrush="{DynamicResource BorderSubtleBrush}"
                       BorderThickness="1"
                       CornerRadius="4">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:GrepHitViewModel">
                    <Border Padding="8,6" Margin="1">
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="2">
                          <TextBlock Text="{Binding Summary}"
                                     FontWeight="SemiBold"
                                     FontSize="11"
                                     Foreground="{DynamicResource PrimaryBlueBrush}"
                                     TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding Detail}"
                                     FontFamily="Menlo, Consolas, monospace"
                                     FontSize="11"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="Test"
                                Classes="ghost"
                                VerticalAlignment="Center"
                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenGrepHitInSubjectCommand}"
                                CommandParameter="{Binding}"
                                ToolTip.Tip="Open this line in Test mode" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Panel>

            <TextBlock Grid.Row="5"
                       Text="{Binding GrepPreviewPath}"
                       FontSize="11"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextTrimming="CharacterEllipsis"
                       Margin="0,0,0,4" />
            <Border Grid.Row="6"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    ClipToBounds="True"
                    MinHeight="120">
              <ae:TextEditor x:Name="GrepPreviewEditor"
                             FontFamily="Menlo, Consolas, monospace"
                             FontSize="12"
                             IsReadOnly="True"
                             WordWrap="False"
                             ShowLineNumbers="True"
                             HorizontalScrollBarVisibility="Auto"
                             VerticalScrollBarVisibility="Auto" />
            </Border>
          </Grid>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
