<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RegexCraft.App.ViewModels"
        xmlns:ae="using:AvaloniaEdit"
        xmlns:analysis="using:RegexCraft.Core.Analysis"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="RegexCraft.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/regexcraft-icon.ico"
        Title="{Binding WindowTitle}"
        Width="1320" Height="860"
        MinWidth="1000" MinHeight="680"
        Background="{DynamicResource BackgroundPrimaryBrush}">

  <!-- Window menus (Windows/Linux menu bar; macOS supplements Application menu). -->
  <NativeMenu.Menu>
    <NativeMenu>
      <NativeMenuItem Header="Help">
        <NativeMenu>
          <NativeMenuItem Header="About RegexCraft"
                          Click="AboutMenuItem_OnClick" />
        </NativeMenu>
      </NativeMenuItem>
    </NativeMenu>
  </NativeMenu.Menu>

  <Design.DataContext>
    <vm:MainWindowViewModel />
  </Design.DataContext>

  <Window.Styles>
    <!-- Mode / tab buttons -->
    <Style Selector="Button.modeTab">
      <Setter Property="Padding" Value="14,7" />
      <Setter Property="Margin" Value="0,0,4,0" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextOnPrimaryBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="MinHeight" Value="30" />
    </Style>
    <Style Selector="Button.modeTab:pointerover">
      <Setter Property="Background" Value="{DynamicResource PrimaryBlueHoverBrush}" />
    </Style>
    <Style Selector="Button.modeTab.active">
      <Setter Property="Background" Value="{DynamicResource AccentBlueSoftBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryBlueBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="Button.panelTab">
      <Setter Property="Padding" Value="14,9" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0,0,0,2" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="MinHeight" Value="34" />
    </Style>
    <Style Selector="Button.panelTab:pointerover">
      <Setter Property="Background" Value="{DynamicResource AccentBlueSoftBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryBlueBrush}" />
    </Style>
    <Style Selector="Button.panelTab.active">
      <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBlueBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryBlueBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Background" Value="{DynamicResource BackgroundSecondaryBrush}" />
    </Style>

    <Style Selector="Button.ghost">
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryBlueBrush}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="MinHeight" Value="26" />
    </Style>
    <Style Selector="Button.ghost:pointerover">
      <Setter Property="Background" Value="{DynamicResource AccentBlueSoftBrush}" />
    </Style>

    <Style Selector="Button.primaryAction">
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="Background" Value="{DynamicResource PrimaryBlueBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextOnPrimaryBrush}" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="MinHeight" Value="30" />
    </Style>
    <Style Selector="Button.primaryAction:pointerover">
      <Setter Property="Background" Value="{DynamicResource PrimaryBlueHoverBrush}" />
    </Style>

    <!-- Token / library category panels: identical full width -->
    <Style Selector="Expander.tokenCategory">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Margin" Value="0,0,0,6" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="{DynamicResource BackgroundTertiaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Expander.tokenCategory /template/ ToggleButton#PART_toggle">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="10,8" />
    </Style>
    <Style Selector="Expander.tokenCategory:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
    </Style>

    <!-- Token row buttons -->
    <Style Selector="Button.tokenItem">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="Margin" Value="2,1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.tokenItem:pointerover">
      <Setter Property="Background" Value="{DynamicResource AccentBlueSoftBrush}" />
    </Style>
    <Style Selector="Button.tokenItem:focus">
      <Setter Property="Background" Value="{DynamicResource AccentBlueSoftBrush}" />
    </Style>

    <!-- Shared panel chrome -->
    <Style Selector="Border.panelChrome">
      <Setter Property="Background" Value="{DynamicResource BackgroundSecondaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
    </Style>
    <Style Selector="Border.panelHeader">
      <Setter Property="Background" Value="{DynamicResource BackgroundTertiaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="Padding" Value="12,8" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="SelectionBrush" Value="{DynamicResource EditorSelectionBrush}" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="MinHeight" Value="30" />
    </Style>
    <Style Selector="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="ListBox">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <!-- Analysis tree starts expanded for usefulness -->
    <Style Selector="TreeViewItem">
      <Setter Property="IsExpanded" Value="True" />
      <Setter Property="Padding" Value="2,1" />
    </Style>
    <Style Selector="TreeViewItem:selected /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="{DynamicResource AccentBlueSoftBrush}" />
    </Style>

    <!-- Right-panel mode host: each mode fills the entire available area -->
    <Style Selector="Grid.rightMode">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="Margin" Value="12" />
    </Style>
    <Style Selector="Border.editorFrame">
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="ClipToBounds" Value="True" />
      <Setter Property="Background" Value="{DynamicResource EditorBackgroundBrush}" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Border.listFrame">
      <Setter Property="Background" Value="{DynamicResource BackgroundTertiaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="GridSplitter.columnSplit">
      <Setter Property="Background" Value="{DynamicResource BorderSubtleBrush}" />
      <Setter Property="Width" Value="5" />
      <Setter Property="MinWidth" Value="5" />
      <Setter Property="ResizeDirection" Value="Columns" />
    </Style>
    <Style Selector="GridSplitter.columnSplit:pointerover">
      <Setter Property="Background" Value="{DynamicResource PrimaryBlueBrush}" />
    </Style>
    <Style Selector="TextBlock.sectionLabel">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.mutedHint">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.emptyState">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="Margin" Value="16,24" />
    </Style>
  </Window.Styles>

  <DockPanel>

    <!-- Toolbar -->
    <Border DockPanel.Dock="Top"
            Background="{DynamicResource PrimaryBlueBrush}"
            Padding="14,10">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <TextBlock Text="RegexCraft"
                     FontSize="18"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource TextOnPrimaryBrush}"
                     VerticalAlignment="Center" />
          <Border Background="{DynamicResource AccentBlueSoftBrush}"
                  CornerRadius="4"
                  Padding="8,2"
                  VerticalAlignment="Center">
            <TextBlock Text="{Binding VersionText}"
                       FontSize="11"
                       FontWeight="Medium"
                       Foreground="{DynamicResource PrimaryBlueBrush}" />
          </Border>
        </StackPanel>

        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="6"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
          <TextBlock Text="Flavor"
                     Foreground="{DynamicResource TextOnPrimaryBrush}"
                     Opacity="0.9"
                     VerticalAlignment="Center"
                     FontSize="12"
                     Margin="0,0,2,0" />
          <ComboBox ItemsSource="{Binding Flavors}"
                    SelectedItem="{Binding SelectedFlavor}"
                    MinWidth="130"
                    MaxWidth="200"
                    ToolTip.Tip="{Binding FlavorTooltip}"
                    AutomationProperties.Name="Regex flavor">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding DisplayName}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <Border Width="1" Height="20" Background="{DynamicResource TextOnPrimaryBrush}" Opacity="0.3" Margin="6,0" />

          <Button Content="Match"
                  Classes="modeTab"
                  Classes.active="{Binding IsMatchMode}"
                  Command="{Binding SelectRightTabCommand}"
                  CommandParameter="Test"
                  ToolTip.Tip="Match mode (Ctrl+1). Live updates while typing. Ctrl+Enter to run." />
          <Button Content="Replace"
                  Classes="modeTab"
                  Classes.active="{Binding IsReplaceMode}"
                  Command="{Binding SelectRightTabCommand}"
                  CommandParameter="Replace"
                  ToolTip.Tip="Replace mode (Ctrl+2) with live preview" />
          <Button Content="Split"
                  Classes="modeTab"
                  Classes.active="{Binding IsSplitMode}"
                  Command="{Binding SelectRightTabCommand}"
                  CommandParameter="Split"
                  ToolTip.Tip="Split mode (Ctrl+3)" />
          <Button Content="Generate"
                  Classes="modeTab"
                  Classes.active="{Binding IsGenerateMode}"
                  Command="{Binding SelectRightTabCommand}"
                  CommandParameter="Generate"
                  ToolTip.Tip="Code generation (Ctrl+4)" />
          <Button Content="GREP"
                  Classes="modeTab"
                  Classes.active="{Binding IsGrepMode}"
                  Command="{Binding SelectRightTabCommand}"
                  CommandParameter="Grep"
                  ToolTip.Tip="Search &amp; replace across files/folders (Ctrl+5)" />
          <Button Content="Compare"
                  Classes="modeTab"
                  Classes.active="{Binding IsCompareMode}"
                  Command="{Binding SelectRightTabCommand}"
                  CommandParameter="Compare"
                  ToolTip.Tip="Compare the same pattern across flavors (Ctrl+6)" />

          <Border Width="1" Height="20" Background="{DynamicResource TextOnPrimaryBrush}" Opacity="0.3" Margin="6,0" />

          <Button Content="Options"
                  Classes="modeTab"
                  Command="{Binding ToggleOptionsCommand}"
                  ToolTip.Tip="Show or hide regex options" />
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Text="Theme"
                     Foreground="{DynamicResource TextOnPrimaryBrush}"
                     Opacity="0.85"
                     VerticalAlignment="Center"
                     FontSize="12" />
          <Button Content="{Binding ThemeLabel}"
                  Command="{Binding CycleThemeCommand}"
                  MinWidth="72"
                  Padding="10,4"
                  ToolTip.Tip="Cycle theme: System → Light → Dark" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Options strip -->
    <Border DockPanel.Dock="Top"
            IsVisible="{Binding OptionsExpanded}"
            Background="{DynamicResource BackgroundSecondaryBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}"
            BorderThickness="0,0,0,1"
            Padding="14,10">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
          <TextBlock Text="Options"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     VerticalAlignment="Center"
                     FontSize="12"
                     Margin="0,0,4,0" />
          <CheckBox Content="Ignore case" IsChecked="{Binding IgnoreCase}"
                    IsEnabled="{Binding IgnoreCaseEnabled}" FontSize="12"
                    ToolTip.Tip="Case-insensitive matching (flavor-dependent)" />
          <CheckBox Content="Multiline" IsChecked="{Binding Multiline}"
                    IsEnabled="{Binding MultilineEnabled}" FontSize="12"
                    ToolTip.Tip="^ and $ match line start/end (flavor-dependent)" />
          <CheckBox Content="Singleline" IsChecked="{Binding Singleline}"
                    IsEnabled="{Binding SinglelineEnabled}" FontSize="12"
                    ToolTip.Tip="Dot (.) matches newline — .NET Singleline / PCRE DOTALL / JS s flag" />
          <CheckBox Content="Explicit capture" IsChecked="{Binding ExplicitCapture}"
                    IsEnabled="{Binding ExplicitCaptureEnabled}" FontSize="12"
                    ToolTip.Tip=".NET: only named groups capture. PCRE2: approximate. Not available in JavaScript." />
          <CheckBox Content="Ignore pattern whitespace" IsChecked="{Binding IgnorePatternWhitespace}"
                    IsEnabled="{Binding IgnorePatternWhitespaceEnabled}" FontSize="12"
                    ToolTip.Tip="Ignore unescaped whitespace and enable # comments (.NET / PCRE extended). Not available in JavaScript." />
        </StackPanel>
        <TextBlock Grid.Column="2"
                   Text="{Binding OptionsContextLabel}"
                   FontSize="11"
                   Foreground="{DynamicResource TextMutedBrush}"
                   VerticalAlignment="Center"
                   Margin="16,0,0,0"
                   TextTrimming="CharacterEllipsis" />
      </Grid>
    </Border>

    <!-- Status bar -->
    <Border DockPanel.Dock="Bottom"
            Background="{DynamicResource BackgroundTertiaryBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}"
            BorderThickness="0,1,0,0"
            Padding="14,8"
            MinHeight="34"
            AutomationProperties.Name="Status bar">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">
        <TextBlock Text="{Binding StatusText}"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   FontSize="12"
                   TextTrimming="CharacterEllipsis"
                   VerticalAlignment="Center"
                   Margin="0,0,12,0" />
        <TextBlock Grid.Column="1"
                   Text="{Binding StatusEngine}"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   FontSize="12"
                   Margin="8,0,0,0"
                   VerticalAlignment="Center" />
        <TextBlock Grid.Column="2"
                   Text="{Binding StatusMatches}"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   FontWeight="SemiBold"
                   FontSize="12"
                   Margin="16,0,0,0"
                   VerticalAlignment="Center" />
        <TextBlock Grid.Column="3"
                   Text="{Binding StatusTime}"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   FontSize="12"
                   Margin="16,0,0,0"
                   VerticalAlignment="Center" />
        <TextBlock Grid.Column="4"
                   Text="{Binding ShortcutHints}"
                   Foreground="{DynamicResource TextMutedBrush}"
                   FontSize="11"
                   Margin="16,0,0,0"
                   VerticalAlignment="Center" />
      </Grid>
    </Border>

    <!-- Body: left | splitter | center | splitter | right
         Right column width is managed in code-behind (Normal vs Compare memory). -->
    <Grid x:Name="MainBodyGrid" ColumnDefinitions="280,5,*,5,400" Margin="0">

      <!-- LEFT: Tokens / Library / History -->
      <Border Grid.Column="0"
              MinWidth="200"
              Background="{DynamicResource BackgroundSecondaryBrush}"
              BorderBrush="{DynamicResource BorderSubtleBrush}"
              BorderThickness="0">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top"
                      Orientation="Horizontal"
                      Background="{DynamicResource BackgroundTertiaryBrush}"
                      Margin="0,0,0,0">
            <Button Content="Tokens"
                    Classes="panelTab"
                    Classes.active="{Binding IsTokensTab}"
                    Command="{Binding SelectLeftTabCommand}"
                    CommandParameter="Tokens"
                    ToolTip.Tip="Insertable regex tokens" />
            <Button Content="Library"
                    Classes="panelTab"
                    Classes.active="{Binding IsLibraryTab}"
                    Command="{Binding SelectLeftTabCommand}"
                    CommandParameter="Library"
                    ToolTip.Tip="Saved patterns" />
            <Button Content="History"
                    Classes="panelTab"
                    Classes.active="{Binding IsHistoryTab}"
                    Command="{Binding SelectLeftTabCommand}"
                    CommandParameter="History"
                    ToolTip.Tip="Recent patterns" />
          </StackPanel>

          <!-- TOKENS -->
          <DockPanel IsVisible="{Binding IsTokensTab}">
            <TextBox DockPanel.Dock="Top"
                     Text="{Binding TokenSearch}"
                     PlaceholderText="Search tokens…"
                     Margin="12,10,12,8"
                     ToolTip.Tip="Multi-word filter: label, insert text, category, or description" />
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
              <!-- Fixed-width stretch so every category panel is identical width -->
              <ItemsControl ItemsSource="{Binding TokenCategories}"
                            Margin="10,0,10,12"
                            HorizontalAlignment="Stretch">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel HorizontalAlignment="Stretch" Spacing="0" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:TokenCategoryViewModel">
                    <Expander Classes="tokenCategory"
                              IsExpanded="True"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch">
                      <Expander.Header>
                        <TextBlock Text="{Binding Name}"
                                   FontWeight="SemiBold"
                                   FontSize="12"
                                   Foreground="{DynamicResource PrimaryBlueBrush}"
                                   HorizontalAlignment="Stretch" />
                      </Expander.Header>
                      <ItemsControl ItemsSource="{Binding Tokens}"
                                    HorizontalAlignment="Stretch"
                                    Margin="2,0,2,6">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:TokenItemViewModel">
                            <Button Classes="tokenItem"
                                    Opacity="{Binding Opacity}"
                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).InsertTokenCommand}"
                                    CommandParameter="{Binding}"
                                    ToolTip.Tip="{Binding Tooltip}">
                              <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Stretch">
                                <TextBlock Text="{Binding Label}"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontSize="12"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding InsertText}"
                                           FontFamily="Menlo, Consolas, monospace"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center" />
                              </Grid>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Expander>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>

          <!-- LIBRARY -->
          <DockPanel IsVisible="{Binding IsLibraryTab}" Margin="0">
            <Border DockPanel.Dock="Top" Padding="12,10" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
              <StackPanel Spacing="6">
                <TextBlock Text="Save current pattern"
                           FontWeight="SemiBold"
                           FontSize="12"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBox Text="{Binding LibraryName}"
                         PlaceholderText="Name"
                         FontSize="12" />
                <TextBox Text="{Binding LibraryDescription}"
                         PlaceholderText="Description (optional)"
                         FontSize="12" />
                <TextBox Text="{Binding LibraryCategory}"
                         PlaceholderText="Category (optional)"
                         FontSize="12" />
                <TextBox Text="{Binding LibraryTags}"
                         PlaceholderText="Tags (comma-separated)"
                         FontSize="12" />
                <CheckBox Content="Favorite"
                          IsChecked="{Binding LibraryFavorite}"
                          FontSize="12" />
                <Button Content="Save to Library"
                        Classes="primaryAction"
                        Command="{Binding SaveToLibraryCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center" />
              </StackPanel>
            </Border>
            <TextBox DockPanel.Dock="Top"
                     Text="{Binding LibrarySearch}"
                     PlaceholderText="Search library…"
                     Margin="12,8,12,6"
                     FontSize="12" />
            <TextBlock DockPanel.Dock="Top"
                       IsVisible="{Binding !LibraryItems.Count}"
                       Text="No library patterns match. Built-in samples load automatically on first run."
                       TextWrapping="Wrap"
                       Margin="14,8"
                       FontSize="12"
                       Foreground="{DynamicResource TextMutedBrush}" />
            <ListBox ItemsSource="{Binding LibraryItems}"
                     Margin="8,0,8,8"
                     Background="Transparent"
                     BorderThickness="0">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:LibraryItemViewModel">
                  <Border Padding="8,8" Margin="0,2" CornerRadius="4"
                          Background="{DynamicResource BackgroundTertiaryBrush}">
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{Binding Name}"
                                   FontWeight="SemiBold"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                        <Border IsVisible="{Binding IsBuiltIn}"
                                Background="{DynamicResource AccentBlueSoftBrush}"
                                CornerRadius="3"
                                Padding="5,1"
                                VerticalAlignment="Center">
                          <TextBlock Text="Built-in"
                                     FontSize="10"
                                     FontWeight="SemiBold"
                                     Foreground="{DynamicResource PrimaryBlueBrush}" />
                        </Border>
                      </StackPanel>
                      <TextBlock Grid.Row="1"
                                 Text="{Binding Subtitle}"
                                 FontSize="11"
                                 FontFamily="Menlo, Consolas, monospace"
                                 Foreground="{DynamicResource TextSecondaryBrush}"
                                 TextTrimming="CharacterEllipsis"
                                 Margin="0,2,0,0" />
                      <StackPanel Grid.Column="1" Grid.RowSpan="2"
                                  Orientation="Horizontal" Spacing="2"
                                  VerticalAlignment="Center">
                        <Button Content="{Binding FavoriteLabel}"
                                Classes="ghost"
                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ToggleLibraryFavoriteCommand}"
                                CommandParameter="{Binding}"
                                ToolTip.Tip="Toggle favorite" />
                        <Button Content="Load"
                                Classes="ghost"
                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).LoadLibraryItemCommand}"
                                CommandParameter="{Binding}" />
                        <Button Content="✕"
                                Classes="ghost"
                                IsVisible="{Binding CanDelete}"
                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).DeleteLibraryItemCommand}"
                                CommandParameter="{Binding}"
                                ToolTip.Tip="Delete" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>

          <!-- HISTORY -->
          <DockPanel IsVisible="{Binding IsHistoryTab}">
            <Border DockPanel.Dock="Top" Padding="12,8">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Recent patterns"
                           FontWeight="SemiBold"
                           FontSize="12"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Content="Clear"
                        Classes="ghost"
                        Command="{Binding ClearHistoryCommand}" />
              </Grid>
            </Border>
            <TextBox DockPanel.Dock="Top"
                     Text="{Binding HistorySearch}"
                     PlaceholderText="Search history…"
                     Margin="12,0,12,6"
                     FontSize="12"
                     ToolTip.Tip="Filter by pattern, subject, or replacement text" />
            <TextBlock DockPanel.Dock="Top"
                       IsVisible="{Binding !HistoryItems.Count}"
                       Text="{Binding HistoryEmptyMessage}"
                       TextWrapping="Wrap"
                       Margin="14,4"
                       FontSize="12"
                       Foreground="{DynamicResource TextMutedBrush}" />
            <ListBox ItemsSource="{Binding HistoryItems}"
                     Margin="8,0,8,8"
                     Background="Transparent"
                     BorderThickness="0">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:HistoryItemViewModel">
                  <Button HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Left"
                          Background="{DynamicResource BackgroundTertiaryBrush}"
                          BorderThickness="0"
                          Padding="10,8"
                          Margin="0,2"
                          CornerRadius="4"
                          Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).LoadHistoryItemCommand}"
                          CommandParameter="{Binding}"
                          ToolTip.Tip="Click to restore">
                    <StackPanel Spacing="2">
                      <TextBlock Text="{Binding Label}"
                                 FontFamily="Menlo, Consolas, monospace"
                                 FontSize="12"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding When}"
                                 FontSize="10"
                                 Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </DockPanel>
      </Border>

      <GridSplitter Grid.Column="1" Classes="columnSplit"
                    ToolTip.Tip="Drag to resize left sidebar" />

      <!-- CENTER: Editor + Analysis -->
      <Grid Grid.Column="2" RowDefinitions="*,5,200" MinWidth="280">
        <Border Grid.Row="0" Background="{DynamicResource BackgroundSecondaryBrush}">
          <DockPanel>
            <Border DockPanel.Dock="Top"
                    Padding="12,8"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="0,0,0,1"
                    Background="{DynamicResource BackgroundTertiaryBrush}">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Regex Editor"
                           Classes="sectionLabel"
                           AutomationProperties.Name="Regex pattern editor" />
                <Button Grid.Column="1"
                        Content="Copy pattern"
                        Classes="ghost"
                        Command="{Binding CopyPatternCommand}"
                        ToolTip.Tip="Copy the full pattern to the clipboard" />
              </Grid>
            </Border>
            <ae:TextEditor x:Name="PatternEditor"
                           FontFamily="Menlo, Consolas, monospace"
                           FontSize="15"
                           ShowLineNumbers="True"
                           Background="{DynamicResource EditorBackgroundBrush}"
                           Foreground="{DynamicResource EditorForegroundBrush}"
                           HorizontalScrollBarVisibility="Auto"
                           VerticalScrollBarVisibility="Auto" />
          </DockPanel>
        </Border>

        <GridSplitter Grid.Row="1"
                      Background="{DynamicResource BorderSubtleBrush}"
                      ResizeDirection="Rows"
                      Height="5" />

        <Border Grid.Row="2"
                MinHeight="100"
                Background="{DynamicResource BackgroundSecondaryBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,1,0,0">
          <DockPanel>
            <Border DockPanel.Dock="Top"
                    Padding="12,7"
                    Background="{DynamicResource BackgroundTertiaryBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="0,0,0,1">
              <TextBlock Text="Analysis Tree — click a node to select it in the editor"
                         Classes="sectionLabel" />
            </Border>
            <TreeView x:Name="AnalysisTree"
                      ItemsSource="{Binding AnalysisNodes}"
                      SelectedItem="{Binding SelectedAnalysisNode}"
                      Margin="6"
                      Background="Transparent"
                      AutomationProperties.Name="Pattern analysis tree">
              <TreeView.ItemTemplate>
                <TreeDataTemplate ItemsSource="{Binding Children}" DataType="analysis:AnalysisNode">
                  <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2">
                    <TextBlock Text="{Binding Title}"
                               FontWeight="SemiBold"
                               FontSize="12"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding Detail}"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="280" />
                    <TextBlock Text="{Binding PatternFragment}"
                               FontFamily="Menlo, Consolas, monospace"
                               FontSize="11"
                               Foreground="{DynamicResource PrimaryBlueBrush}"
                               Opacity="0.95"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="220" />
                  </StackPanel>
                </TreeDataTemplate>
              </TreeView.ItemTemplate>
            </TreeView>
          </DockPanel>
        </Border>
      </Grid>

      <GridSplitter x:Name="RightColumnSplitter"
                    Grid.Column="3"
                    Classes="columnSplit"
                    ToolTip.Tip="Drag to resize right panel" />

      <!-- RIGHT: single host so every mode fills remaining space -->
      <Border x:Name="RightPanelHost"
              Grid.Column="4"
              MinWidth="300"
              Background="{DynamicResource BackgroundSecondaryBrush}"
              BorderBrush="{DynamicResource BorderSubtleBrush}"
              BorderThickness="0">
        <DockPanel LastChildFill="True">
          <StackPanel DockPanel.Dock="Top"
                      Orientation="Horizontal"
                      Background="{DynamicResource BackgroundTertiaryBrush}">
            <Button Content="Test"
                    Classes="panelTab"
                    Classes.active="{Binding IsTestTab}"
                    Command="{Binding SelectRightTabCommand}"
                    CommandParameter="Test"
                    ToolTip.Tip="Match testing with highlighting"
                    AutomationProperties.Name="Test mode tab" />
            <Button Content="Replace"
                    Classes="panelTab"
                    Classes.active="{Binding IsReplaceTab}"
                    Command="{Binding SelectRightTabCommand}"
                    CommandParameter="Replace"
                    ToolTip.Tip="Replace preview with highlighting"
                    AutomationProperties.Name="Replace mode tab" />
            <Button Content="Split"
                    Classes="panelTab"
                    Classes.active="{Binding IsSplitTab}"
                    Command="{Binding SelectRightTabCommand}"
                    CommandParameter="Split"
                    ToolTip.Tip="Split subject on matches"
                    AutomationProperties.Name="Split mode tab" />
            <Button Content="Generate"
                    Classes="panelTab"
                    Classes.active="{Binding IsGenerateTab}"
                    Command="{Binding SelectRightTabCommand}"
                    CommandParameter="Generate"
                    ToolTip.Tip="Generate code snippets"
                    AutomationProperties.Name="Generate mode tab" />
            <Button Content="GREP"
                    Classes="panelTab"
                    Classes.active="{Binding IsGrepTab}"
                    Command="{Binding SelectRightTabCommand}"
                    CommandParameter="Grep"
                    ToolTip.Tip="Search &amp; replace across files"
                    AutomationProperties.Name="GREP mode tab" />
            <Button Content="Compare"
                    Classes="panelTab"
                    Classes.active="{Binding IsCompareTab}"
                    Command="{Binding SelectRightTabCommand}"
                    CommandParameter="Compare"
                    ToolTip.Tip="Side-by-side multi-flavor comparison"
                    AutomationProperties.Name="Compare mode tab" />
          </StackPanel>

          <Border DockPanel.Dock="Top"
                  IsVisible="{Binding ShowFidelityBanner}"
                  Background="{DynamicResource AccentBlueSoftBrush}"
                  BorderBrush="{DynamicResource PrimaryBlueBrush}"
                  BorderThickness="0,0,0,1"
                  Padding="12,8"
                  Margin="0,0,0,0">
            <TextBlock Text="{Binding FidelityBannerText}"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       AutomationProperties.Name="Flavor fidelity note" />
          </Border>

          <Border DockPanel.Dock="Top"
                  IsVisible="{Binding HasError}"
                  BorderBrush="{DynamicResource ErrorBrush}"
                  BorderThickness="0,0,0,2"
                  Background="{DynamicResource BackgroundTertiaryBrush}"
                  Padding="10,8">
            <TextBlock Text="{Binding ErrorText}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource ErrorBrush}"
                       FontSize="12" />
          </Border>

          <!-- Mode host: only one mode visible; all stretch to fill this Grid -->
          <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

            <!-- TEST -->
            <Grid Classes="rightMode"
                  IsVisible="{Binding IsTestTab}"
                  RowDefinitions="Auto,*,Auto,*"
                  AutomationProperties.Name="Test panel">
              <TextBlock Grid.Row="0"
                         Text="Subject"
                         Classes="sectionLabel"
                         Margin="0,0,0,6" />
              <Border Grid.Row="1" Classes="editorFrame" Margin="0,0,0,10">
                <ae:TextEditor x:Name="SubjectEditor"
                               FontFamily="Menlo, Consolas, monospace"
                               FontSize="13"
                               WordWrap="True"
                               Background="{DynamicResource EditorBackgroundBrush}"
                               Foreground="{DynamicResource EditorForegroundBrush}"
                               HorizontalScrollBarVisibility="Disabled"
                               VerticalScrollBarVisibility="Auto" />
              </Border>

              <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                <TextBlock Text="Matches &amp; Groups" Classes="sectionLabel" />
                <Button Grid.Column="1"
                        Content="Run"
                        Classes="primaryAction"
                        Command="{Binding RunTestCommand}"
                        ToolTip.Tip="Run match immediately (Ctrl+Enter)" />
              </Grid>

              <Panel Grid.Row="3">
                <Border Classes="listFrame"
                        IsVisible="{Binding !Matches.Count}">
                  <TextBlock Text="{Binding EmptyMatchesMessage}" Classes="emptyState" />
                </Border>
                <ListBox ItemsSource="{Binding Matches}"
                         IsVisible="{Binding Matches.Count}"
                         Background="{DynamicResource BackgroundTertiaryBrush}"
                         BorderBrush="{DynamicResource BorderSubtleBrush}"
                         BorderThickness="1"
                         CornerRadius="4"
                         HorizontalAlignment="Stretch"
                         VerticalAlignment="Stretch">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:MatchItemViewModel">
                      <Expander IsExpanded="{Binding IsExpanded}" Margin="2">
                        <Expander.Header>
                          <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding Summary}"
                                       FontFamily="Menlo, Consolas, monospace"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                              <Button Content="Copy"
                                      Classes="ghost"
                                      Command="{Binding CopyMatchCommand}"
                                      ToolTip.Tip="Copy match value" />
                              <Button Content="Go"
                                      Classes="ghost"
                                      Command="{Binding SelectMatchCommand}"
                                      ToolTip.Tip="Select match in subject" />
                            </StackPanel>
                          </Grid>
                        </Expander.Header>
                        <ItemsControl ItemsSource="{Binding Groups}" Margin="8,4,4,4">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:GroupItemViewModel">
                              <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,3">
                                <Border Background="{DynamicResource AccentBlueSoftBrush}"
                                        CornerRadius="3"
                                        Padding="6,2"
                                        Margin="0,0,8,0">
                                  <TextBlock Text="{Binding DisplayName}"
                                             FontSize="11"
                                             FontWeight="SemiBold"
                                             Foreground="{DynamicResource PrimaryBlueBrush}" />
                                </Border>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding DisplayValue}"
                                           FontFamily="Menlo, Consolas, monospace"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding RangeText}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Margin="8,0"
                                           VerticalAlignment="Center" />
                                <StackPanel Grid.Column="3" Orientation="Horizontal">
                                  <Button Content="Copy"
                                          Classes="ghost"
                                          Command="{Binding CopyGroupCommand}" />
                                  <Button Content="Go"
                                          Classes="ghost"
                                          Command="{Binding SelectGroupCommand}" />
                                </StackPanel>
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </Expander>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Panel>
            </Grid>

            <!-- REPLACE -->
            <Grid Classes="rightMode"
                  IsVisible="{Binding IsReplaceTab}"
                  RowDefinitions="Auto,Auto,Auto,*,Auto"
                  AutomationProperties.Name="Replace panel">
              <TextBlock Grid.Row="0"
                         Text="Replacement pattern"
                         Classes="sectionLabel"
                         Margin="0,0,0,4" />
              <StackPanel Grid.Row="1" Spacing="4" Margin="0,0,0,6">
                <TextBox Text="{Binding Replacement}"
                         FontFamily="Menlo, Consolas, monospace"
                         PlaceholderText="$1  ${name}  $&amp;  \1 …"
                         MinHeight="34"
                         ToolTip.Tip="Supports $1, ${name}, $&amp;, and engine-specific backreferences"
                         AutomationProperties.Name="Replacement pattern" />
                <TextBlock Classes="mutedHint"
                           Text="Backreferences: $1, ${name}, $&amp;, \1 — live preview while typing" />
              </StackPanel>
              <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                <TextBlock Text="Preview" Classes="sectionLabel" />
                <Button Grid.Column="1"
                        Content="Preview Replace"
                        Classes="primaryAction"
                        Command="{Binding RunReplaceCommand}"
                        ToolTip.Tip="Run replace (Ctrl+Enter)" />
              </Grid>
              <Border Grid.Row="3" Classes="editorFrame">
                <ae:TextEditor x:Name="ReplacePreviewEditor"
                               FontFamily="Menlo, Consolas, monospace"
                               FontSize="13"
                               WordWrap="True"
                               IsReadOnly="True"
                               Background="{DynamicResource EditorBackgroundBrush}"
                               Foreground="{DynamicResource EditorForegroundBrush}"
                               HorizontalScrollBarVisibility="Disabled"
                               VerticalScrollBarVisibility="Auto" />
              </Border>
              <Border Grid.Row="4"
                      Margin="0,10,0,0"
                      Padding="0,2,0,0"
                      BorderBrush="{DynamicResource BorderSubtleBrush}"
                      BorderThickness="0,1,0,0">
                <TextBlock Margin="0,8,0,0"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}">
                  <TextBlock.Text>
                    <MultiBinding StringFormat="Replacements: {0}">
                      <Binding Path="ReplaceCount" />
                    </MultiBinding>
                  </TextBlock.Text>
                </TextBlock>
              </Border>
            </Grid>

            <!-- SPLIT -->
            <Grid Classes="rightMode"
                  IsVisible="{Binding IsSplitTab}"
                  RowDefinitions="Auto,Auto,*"
                  AutomationProperties.Name="Split panel">
              <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                <CheckBox Content="Remove empty entries"
                          IsChecked="{Binding RemoveEmptySplitEntries}"
                          FontSize="12"
                          VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Content="Run Split"
                        Classes="primaryAction"
                        Command="{Binding RunSplitCommand}"
                        ToolTip.Tip="Split subject on pattern matches (Ctrl+Enter)" />
              </Grid>
              <TextBlock Grid.Row="1"
                         FontSize="12"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         Margin="0,0,0,8">
                <TextBlock.Text>
                  <MultiBinding StringFormat="Parts: {0}">
                    <Binding Path="SplitPartCount" />
                  </MultiBinding>
                </TextBlock.Text>
              </TextBlock>
              <Panel Grid.Row="2">
                <Border Classes="listFrame" IsVisible="{Binding !SplitParts.Count}">
                  <TextBlock Classes="emptyState"
                             Text="No split parts yet. Enter a pattern and subject, then Run Split (or type to update live)." />
                </Border>
                <ListBox ItemsSource="{Binding SplitParts}"
                         IsVisible="{Binding SplitParts.Count}"
                         Background="{DynamicResource BackgroundTertiaryBrush}"
                         BorderBrush="{DynamicResource BorderSubtleBrush}"
                         BorderThickness="1"
                         CornerRadius="4"
                         HorizontalAlignment="Stretch"
                         VerticalAlignment="Stretch">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:SplitPartViewModel">
                      <Border Padding="10,8" Margin="2">
                        <TextBlock Text="{Binding Summary}"
                                   FontFamily="Menlo, Consolas, monospace"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextWrapping="Wrap" />
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Panel>
            </Grid>

            <!-- GENERATE -->
            <Grid Classes="rightMode"
                  IsVisible="{Binding IsGenerateTab}"
                  RowDefinitions="Auto,Auto,Auto,*"
                  AutomationProperties.Name="Generate panel">
              <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,10">
                <TextBlock Text="Code Generation" Classes="sectionLabel" FontSize="13" />
                <TextBlock Classes="mutedHint"
                           Text="Snippets update automatically for the selected language when the pattern, options, flavor, or operation changes. Default language is C#." />
              </StackPanel>
              <Grid Grid.Row="1" ColumnDefinitions="*,*" Margin="0,0,0,8">
                <StackPanel Margin="0,0,6,0" Spacing="4">
                  <TextBlock Text="Language"
                             FontSize="11"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource TextSecondaryBrush}" />
                  <ComboBox ItemsSource="{Binding CodeLanguages}"
                            SelectedItem="{Binding SelectedCodeLanguage}"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.Name="Code language">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding DisplayName}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="6,0,0,0" Spacing="4">
                  <TextBlock Text="Operation"
                             FontSize="11"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource TextSecondaryBrush}" />
                  <ComboBox ItemsSource="{Binding CodegenOperations}"
                            SelectedItem="{Binding SelectedCodegenOperation}"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.Name="Code operation">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding DisplayName}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>
              </Grid>
              <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,0,0,8">
                <Button Content="Copy code"
                        Classes="primaryAction"
                        Command="{Binding CopyGeneratedCodeCommand}"
                        ToolTip.Tip="Copy generated snippet to clipboard" />
              </StackPanel>
              <Border Grid.Row="3" Classes="editorFrame">
                <ae:TextEditor x:Name="GenerateCodeEditor"
                               FontFamily="Menlo, Consolas, monospace"
                               FontSize="12"
                               IsReadOnly="True"
                               WordWrap="False"
                               ShowLineNumbers="True"
                               Background="{DynamicResource EditorBackgroundBrush}"
                               Foreground="{DynamicResource EditorForegroundBrush}"
                               HorizontalScrollBarVisibility="Auto"
                               VerticalScrollBarVisibility="Auto" />
              </Border>
            </Grid>

            <!-- GREP -->
            <Grid Classes="rightMode"
                  IsVisible="{Binding IsGrepTab}"
                  RowDefinitions="Auto,Auto,Auto,Auto,*,Auto,*"
                  AutomationProperties.Name="GREP panel">
              <TextBlock Grid.Row="0"
                         Text="GREP — search &amp; replace across files"
                         Classes="sectionLabel"
                         FontSize="13"
                         Margin="0,0,0,10" />

              <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                <TextBox Text="{Binding GrepRootPath}"
                         PlaceholderText="Folder path…"
                         FontSize="12"
                         FontFamily="Menlo, Consolas, monospace"
                         ToolTip.Tip="Root folder to scan"
                         AutomationProperties.Name="GREP root folder" />
                <Button Grid.Column="1"
                        Content="Browse…"
                        Classes="primaryAction"
                        Margin="8,0,0,0"
                        Command="{Binding BrowseGrepFolderCommand}"
                        ToolTip.Tip="Pick a folder to search" />
              </Grid>

              <Border Grid.Row="2"
                      Background="{DynamicResource BackgroundTertiaryBrush}"
                      BorderBrush="{DynamicResource BorderSubtleBrush}"
                      BorderThickness="1"
                      CornerRadius="6"
                      Padding="10,8"
                      Margin="0,0,0,8">
                <StackPanel Spacing="8">
                  <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Text="Include"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Width="58"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBox Grid.Column="1"
                             Text="{Binding GrepIncludeGlobs}"
                             FontSize="11"
                             FontFamily="Menlo, Consolas, monospace"
                             ToolTip.Tip="Include globs, semicolon-separated (e.g. *.cs;*.json)" />
                  </Grid>
                  <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Text="Exclude"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Width="58"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBox Grid.Column="1"
                             Text="{Binding GrepExcludeGlobs}"
                             FontSize="11"
                             FontFamily="Menlo, Consolas, monospace"
                             ToolTip.Tip="Exclude globs (e.g. bin/**;obj/**;.git/**)" />
                  </Grid>
                  <StackPanel Orientation="Horizontal" Spacing="16">
                    <CheckBox Content="Recursive"
                              IsChecked="{Binding GrepRecursive}"
                              FontSize="12" />
                    <CheckBox Content="Dry-run replace"
                              IsChecked="{Binding GrepDryRun}"
                              FontSize="12"
                              ToolTip.Tip="Preview replacements without writing files" />
                    <CheckBox Content="Backup (.bak)"
                              IsChecked="{Binding GrepCreateBackup}"
                              FontSize="12"
                              ToolTip.Tip="Write .bak beside each modified file when applying" />
                  </StackPanel>
                </StackPanel>
              </Border>

              <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,0,0,8">
                <StackPanel Orientation="Vertical" Spacing="3" VerticalAlignment="Center">
                  <TextBlock Text="{Binding GrepSummary}"
                             FontSize="11"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding GrepProgressText}"
                             FontSize="11"
                             Foreground="{DynamicResource TextMutedBrush}"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding GrepReplaceSummary}"
                             FontSize="11"
                             Foreground="{DynamicResource PrimaryBlueBrush}"
                             TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button Grid.Column="1"
                        Content="Search"
                        Classes="primaryAction"
                        Command="{Binding RunGrepSearchCommand}"
                        IsEnabled="{Binding !IsGrepRunning}"
                        Margin="6,0,0,0"
                        ToolTip.Tip="Search files with the current pattern (Ctrl+Enter)" />
                <Button Grid.Column="2"
                        Content="Replace"
                        Classes="primaryAction"
                        Command="{Binding RunGrepReplaceCommand}"
                        IsEnabled="{Binding !IsGrepRunning}"
                        Margin="6,0,0,0"
                        ToolTip.Tip="Replace across files (respects Dry-run)" />
                <Button Grid.Column="3"
                        Content="Cancel"
                        Classes="ghost"
                        Command="{Binding CancelGrepCommand}"
                        IsEnabled="{Binding IsGrepRunning}"
                        Margin="6,0,0,0"
                        ToolTip.Tip="Cancel the running GREP operation" />
              </Grid>

              <Panel Grid.Row="4" Margin="0,0,0,8">
                <Border Classes="listFrame" IsVisible="{Binding !GrepHits.Count}">
                  <TextBlock Text="{Binding GrepEmptyMessage}" Classes="emptyState" />
                </Border>
                <ListBox ItemsSource="{Binding GrepHits}"
                         SelectedItem="{Binding SelectedGrepHit}"
                         IsVisible="{Binding GrepHits.Count}"
                         Background="{DynamicResource BackgroundTertiaryBrush}"
                         BorderBrush="{DynamicResource BorderSubtleBrush}"
                         BorderThickness="1"
                         CornerRadius="4"
                         HorizontalAlignment="Stretch"
                         VerticalAlignment="Stretch">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:GrepHitViewModel">
                      <Border Padding="8,6" Margin="1" CornerRadius="3">
                        <Grid ColumnDefinitions="*,Auto">
                          <StackPanel Spacing="2">
                            <TextBlock Text="{Binding Summary}"
                                       FontWeight="SemiBold"
                                       FontSize="11"
                                       Foreground="{DynamicResource PrimaryBlueBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Detail}"
                                       FontFamily="Menlo, Consolas, monospace"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <Button Grid.Column="1"
                                  Content="Test"
                                  Classes="ghost"
                                  VerticalAlignment="Center"
                                  Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenGrepHitInSubjectCommand}"
                                  CommandParameter="{Binding}"
                                  ToolTip.Tip="Open this line in Test mode" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Panel>

              <TextBlock Grid.Row="5"
                         Text="{Binding GrepPreviewPath}"
                         FontSize="11"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         TextTrimming="CharacterEllipsis"
                         Margin="0,0,0,4" />
              <Border Grid.Row="6" Classes="editorFrame" MinHeight="100">
                <ae:TextEditor x:Name="GrepPreviewEditor"
                               FontFamily="Menlo, Consolas, monospace"
                               FontSize="12"
                               IsReadOnly="True"
                               WordWrap="False"
                               ShowLineNumbers="True"
                               Background="{DynamicResource EditorBackgroundBrush}"
                               Foreground="{DynamicResource EditorForegroundBrush}"
                               HorizontalScrollBarVisibility="Auto"
                               VerticalScrollBarVisibility="Auto" />
              </Border>
            </Grid>

            <!-- COMPARE -->
            <Grid Classes="rightMode"
                  IsVisible="{Binding IsCompareTab}"
                  RowDefinitions="Auto,Auto,Auto,*,Auto"
                  AutomationProperties.Name="Compare panel">
              <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,8">
                <TextBlock Text="Compare flavors"
                           Classes="sectionLabel"
                           FontSize="13" />
                <TextBlock Classes="mutedHint"
                           Text="Run the same pattern and subject on 2–4 flavors side-by-side. Results update as you type." />
              </StackPanel>

              <Border Grid.Row="1"
                      Background="{DynamicResource BackgroundTertiaryBrush}"
                      BorderBrush="{DynamicResource BorderSubtleBrush}"
                      BorderThickness="1"
                      CornerRadius="6"
                      Padding="10,8"
                      Margin="0,0,0,8">
                <StackPanel Spacing="6">
                  <Grid ColumnDefinitions="*,Auto,Auto">
                    <TextBlock Text="{Binding CompareSelectionHint}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="1"
                            Content="Run compare"
                            Classes="primaryAction"
                            Command="{Binding RunCompareCommand}"
                            IsEnabled="{Binding !IsCompareRunning}"
                            Margin="6,0,0,0"
                            ToolTip.Tip="Compare now (Ctrl+Enter)"
                            AutomationProperties.Name="Run compare" />
                    <Button Grid.Column="2"
                            Content="Copy summary"
                            Classes="ghost"
                            Command="{Binding CopyCompareSummaryCommand}"
                            Margin="6,0,0,0"
                            ToolTip.Tip="Copy full comparison text to clipboard"
                            AutomationProperties.Name="Copy compare summary" />
                  </Grid>
                  <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                VerticalScrollBarVisibility="Disabled"
                                MaxHeight="72">
                    <ItemsControl ItemsSource="{Binding CompareFlavorChoices}"
                                  AutomationProperties.Name="Compare flavor selection">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:CompareFlavorChoiceViewModel">
                          <CheckBox Content="{Binding DisplayName}"
                                    IsChecked="{Binding IsSelected}"
                                    Margin="0,2,12,2"
                                    FontSize="12"
                                    ToolTip.Tip="{Binding Subtitle}"
                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CompareFlavorSelectionChangedCommand}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </StackPanel>
              </Border>

              <StackPanel Grid.Row="2" Spacing="3" Margin="0,0,0,8">
                <TextBlock Text="{Binding CompareSummary}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           TextTrimming="CharacterEllipsis"
                           AutomationProperties.Name="Compare summary" />
                <ItemsControl ItemsSource="{Binding CompareDifferenceNotes}"
                              IsVisible="{Binding CompareDifferenceNotes.Count}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding}"
                                 FontSize="11"
                                 TextWrapping="Wrap"
                                 Margin="0,1"
                                 Foreground="{DynamicResource PrimaryBlueBrush}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <Panel Grid.Row="3">
                <Border Classes="listFrame" IsVisible="{Binding !CompareCards.Count}">
                  <TextBlock Text="{Binding CompareEmptyMessage}" Classes="emptyState" />
                </Border>
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              IsVisible="{Binding CompareCards.Count}">
                  <ItemsControl ItemsSource="{Binding CompareCards}"
                                AutomationProperties.Name="Compare result cards">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="10" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:CompareCardViewModel">
                        <Border Width="260"
                                MinHeight="200"
                                Background="{DynamicResource BackgroundSecondaryBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,10"
                                Margin="0,0,2,4">
                          <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,8">
                              <TextBlock Text="{Binding Header}"
                                         FontWeight="SemiBold"
                                         FontSize="12"
                                         TextWrapping="Wrap"
                                         Foreground="{DynamicResource TextPrimaryBrush}" />
                              <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Background="{DynamicResource AccentBlueSoftBrush}"
                                        CornerRadius="3"
                                        Padding="6,2">
                                  <TextBlock Text="{Binding FidelityBadge}"
                                             FontSize="10"
                                             FontWeight="SemiBold"
                                             Foreground="{DynamicResource PrimaryBlueBrush}" />
                                </Border>
                                <TextBlock Text="{Binding ValidityLabel}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding MatchCountLabel}"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding DurationLabel}"
                                           FontSize="10"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                              </StackPanel>
                              <TextBlock Text="{Binding ErrorText}"
                                         IsVisible="{Binding !IsValid}"
                                         FontSize="11"
                                         TextWrapping="Wrap"
                                         Foreground="{DynamicResource ErrorBrush}" />
                              <TextBlock Text="{Binding FidelityNote}"
                                         IsVisible="{Binding ShowFidelityNote}"
                                         FontSize="10"
                                         TextWrapping="Wrap"
                                         Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>

                            <StackPanel DockPanel.Dock="Bottom" Spacing="2" Margin="0,8,0,0"
                                        IsVisible="{Binding HasNotes}">
                              <TextBlock Text="Key notes"
                                         FontSize="10"
                                         FontWeight="SemiBold"
                                         Foreground="{DynamicResource TextSecondaryBrush}" />
                              <ItemsControl ItemsSource="{Binding KeyNotes}">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate>
                                    <TextBlock Text="{Binding}"
                                               FontSize="10"
                                               TextWrapping="Wrap"
                                               Margin="0,1"
                                               Foreground="{DynamicResource TextMutedBrush}" />
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </StackPanel>

                            <StackPanel Spacing="2">
                              <TextBlock Text="Matches"
                                         FontSize="10"
                                         FontWeight="SemiBold"
                                         Foreground="{DynamicResource TextSecondaryBrush}" />
                              <TextBlock Text="{Binding EmptyMatchesMessage}"
                                         IsVisible="{Binding !HasMatches}"
                                         FontSize="11"
                                         Foreground="{DynamicResource TextMutedBrush}" />
                              <ItemsControl ItemsSource="{Binding MatchLines}"
                                            IsVisible="{Binding HasMatches}">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate>
                                    <TextBlock Text="{Binding}"
                                               FontFamily="Menlo, Consolas, monospace"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Margin="0,1"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </StackPanel>
                          </DockPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Panel>

              <TextBlock Grid.Row="4"
                         Classes="mutedHint"
                         Margin="0,8,0,0"
                         Text="Tip: differences highlight validity, match counts, first-match offsets, dropped options, and unsupported tokens." />
            </Grid>
          </Grid>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
