<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="RegexCraft.Tests.Headless.TestApp"
             Name="RegexCraft"
             RequestedThemeVariant="Light">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://RegexCraft.App/Themes/Colors.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />

    <Style Selector="Button.primaryAction">
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="Background" Value="{DynamicResource PrimaryBlueBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextOnPrimaryBrush}" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="MinHeight" Value="30" />
    </Style>
    <Style Selector="Button.primaryAction:pointerover">
      <Setter Property="Background" Value="{DynamicResource PrimaryBlueHoverBrush}" />
    </Style>
    <Style Selector="Button.ghost">
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryBlueBrush}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="MinHeight" Value="26" />
    </Style>
    <Style Selector="Button.ghost:pointerover">
      <Setter Property="Background" Value="{DynamicResource AccentBlueSoftBrush}" />
    </Style>
  </Application.Styles>
</Application>
